{
  "name": "bookgen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "bookgen": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "bookgen": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "dependencies": {
    "@fontsource/noto-sans-mono": "5.3.0",
    "@openai/codex-sdk": "0.162.1",
    "commander": "15.0.0",
    "entities": "8.1.0",
    "marked": "18.1.1",
    "opentype.js": "2.0.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "@types/opentype.js": "1.3.10",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.71.1"
  }
}
